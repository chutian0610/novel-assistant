{
  "name": "novel-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "小说 agent 工作台：素材库 + 拆书 + 章节管线 + 事实系统",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json && vue-tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
